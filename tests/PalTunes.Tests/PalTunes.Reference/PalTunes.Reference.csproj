<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banc de comparaison des moteurs avec un solveur exact (Google OR-Tools CP-SAT). Hors livraison : outil de validation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PalTunes.Core\PalTunes.Core.csproj" />
  </ItemGroup>

</Project>
