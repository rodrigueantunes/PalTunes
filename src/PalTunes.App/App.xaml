<Application x:Class="PalTunes.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PalTunes.App.Converters"
             StartupUri="Views/MainWindow.xaml"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Extra.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:KindGlyphConverter x:Key="KindGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
