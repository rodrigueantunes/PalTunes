<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette sombre (0.2.3) : fonds anthracite, cartes un ton au-dessus, textes clairs, bleu inchangé. -->
    <Color x:Key="ColorBg">#1B2026</Color>
    <Color x:Key="ColorPanelDark">#34495E</Color>
    <Color x:Key="ColorPanelDarker">#2C3E50</Color>
    <Color x:Key="ColorCard">#242A31</Color>
    <Color x:Key="ColorPrimary">#3E9BDC</Color>
    <Color x:Key="ColorPrimaryDark">#7DBDEB</Color>
    <Color x:Key="ColorPrimarySoft">#1E3446</Color>
    <Color x:Key="ColorSuccess">#2ECC71</Color>
    <Color x:Key="ColorWarning">#F5A623</Color>
    <Color x:Key="ColorDanger">#F0675A</Color>
    <Color x:Key="ColorText">#E4E9EE</Color>
    <Color x:Key="ColorMuted">#98A5B1</Color>
    <Color x:Key="ColorLine">#3A444F</Color>
    <Color x:Key="ColorCardBorder">#333C46</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="PanelDarkBrush" Color="{StaticResource ColorPanelDark}" />
    <SolidColorBrush x:Key="PanelDarkerBrush" Color="{StaticResource ColorPanelDarker}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource ColorPrimarySoft}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource ColorCardBorder}" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2C343D" />

    <!-- Colonne de navigation : un peu plus sombre qu'en mode clair -->
    <LinearGradientBrush x:Key="NavPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22303D" Offset="0" />
        <GradientStop Color="#161E26" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="NavBadgeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="NavMutedBrush" Color="#8FA1B0" />

    <!-- Fond des vues 3D : dégradé sombre -->
    <LinearGradientBrush x:Key="Viewport3DBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B333C" Offset="0" />
        <GradientStop Color="#232A31" Offset="0.55" />
        <GradientStop Color="#1A2026" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SoftPanelBrush" Color="#2A313A" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#4A3A1C" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1D3B2B" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F5B041" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#58D68D" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#F2242A31" />
    <SolidColorBrush x:Key="SectionTextBrush" Color="#A9B6C2" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#2A313A" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#272E35" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#323A43" />
    <SolidColorBrush x:Key="TrackBrush" Color="#3A444F" />
    <SolidColorBrush x:Key="PressedBrush" Color="#323B45" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#566472" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#883E9BDC" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#3A2A45" />

    <!-- Couleurs système (modèles WPF classiques, menus, sélection) alignées sur la palette -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E4E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E4E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E4E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#242A31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A313A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#242A31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E9BDC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3446" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#98A5B1" />
</ResourceDictionary>
