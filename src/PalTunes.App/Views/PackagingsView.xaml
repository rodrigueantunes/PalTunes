<UserControl x:Class="PalTunes.App.Views.PackagingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:b="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
             xmlns:ctl="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:m="clr-namespace:PalTunes.Core.Models;assembly=PalTunes.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PackagingsViewModel}"
             d:DesignWidth="1500" d:DesignHeight="900">
    <UserControl.Resources>
        <x:Array x:Key="Counts" Type="sys:Int32">
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
        </x:Array>
        <DataTemplate x:Key="ArticleItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DimensionsText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Designation}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid rc:ResizableColumns.Key="Conditionnements">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Liste ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Conditionnements" FontSize="17" FontWeight="Bold" />
                    <TextBox Style="{StaticResource SearchBox}" Margin="0,10,0,6" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <WrapPanel Margin="0,2,0,8">
                        <Button Style="{StaticResource RoundedButton}" Command="{Binding NewCommand}" Padding="10,6" Margin="0,0,6,0"
                                ToolTip="Conditionnement mono-article">
                            <Button.CommandParameter>
                                <x:Static Member="m:PackagingKind.Homogene" />
                            </Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                <TextBlock Text="Homogène" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RoundedButton}" Command="{Binding NewCommand}" Padding="10,6" Margin="0,0,6,0"
                                Background="#8E44AD" ToolTip="Conditionnement multi-articles">
                            <Button.CommandParameter>
                                <x:Static Member="m:PackagingKind.Heterogene" />
                            </Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                <TextBlock Text="Hétérogène" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DuplicateCommand}" ToolTip="Dupliquer">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DeleteCommand}" ToolTip="Supprimer">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <!-- En cours (non enregistrés), puis Récents : sections repliables empilées en haut, hauteur selon leur contenu. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Visibility="{Binding HasInProgress, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <ToggleButton Style="{StaticResource SectionToggle}" IsChecked="{Binding IsInProgressOpen}"
                                      ToolTip="Conditionnements créés ou modifiés, pas encore enregistrés : gardés pendant la session">
                            <TextBlock Text="{Binding InProgressTitle}" />
                        </ToggleButton>
                        <ListBox Style="{StaticResource CardListBox}" ItemsSource="{Binding InProgress}" SelectedItem="{Binding SelectedWork}" MaxHeight="260"
                                 Visibility="{Binding IsInProgressOpen, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                ToolTip="Abandonner cette saisie (non enregistrée)">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                                        </Button>
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding State}" FontSize="10.5" Foreground="{StaticResource WarningTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4,0" Content="Tout voir"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="PackagingLibrary"
                                ToolTip="Espace « Gestion des conditionnements » (Ctrl+7)" />
                        <ToggleButton Style="{StaticResource SectionToggle}" IsChecked="{Binding IsRecentOpen}"
                                      ToolTip="Les 10 derniers conditionnements modifiés ; tous les autres : espace « Gestion des conditionnements »">
                            <TextBlock Text="{Binding ListTitle}" />
                        </ToggleButton>
                    </DockPanel>

                    <ListBox Grid.Row="3" Style="{StaticResource CardListBox}" ItemsSource="{Binding Packagings}" SelectedItem="{Binding SelectedPackaging}"
                             VerticalAlignment="Top" Visibility="{Binding IsRecentOpen, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Heterogene">
                                                            <Setter Property="Background" Value="{StaticResource PurpleSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10.5" Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding Solution, Converter={StaticResource NotNullToVisibility}}">
                                        <Run Text="✓ " /><Run Text="{Binding Solution.Title, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===================== Solutions et vues ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="6" Padding="14,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar IsIndeterminate="True" Width="90" Height="6" Style="{StaticResource KpiBar}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Muted}" Text="Calcul en cours…" />
                        </StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold">
                            <Run Text="Solutions" />
                            <Run Text="{Binding Solutions.Count, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                        </TextBlock>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}" Margin="10,0,0,0" Visibility="{Binding ShowingProposals, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Assistant : comparaison de toutes les palettes actives (densité de transport)" FontSize="11" Foreground="{StaticResource WarningTextBrush}" />
                        </Border>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6"
                               Visibility="{Binding Message, Converter={StaticResource NotNullToVisibility}}" />
                    <ListBox Style="{StaticResource HCardListBox}" ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" MinHeight="40">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="230" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessBrush}" Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="★ Recommandée" FontSize="10.5" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource DangerBrush}" Visibility="{Binding Compliant, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="Non conforme" FontSize="10.5" Foreground="White" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="⚠" FontSize="10.5" Foreground="{StaticResource WarningTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                    <TextBlock Text="{Binding Orientation}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Orientation}" />
                                    <TextBlock Text="{Binding BaseLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Recommandation, alertes -->
            <Border Grid.Row="1" Margin="8,0,8,4" Padding="12,8" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}"
                    Visibility="{Binding Recommendation, Converter={StaticResource NotNullToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE734;" Foreground="{StaticResource SuccessTextBrush}" Margin="0,2,8,0" />
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{StaticResource SuccessTextBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Violations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3,0,0">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE783;" Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3,0,0">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource WarningTextBrush}" Margin="0,2,8,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="2" Margin="8,4,8,6">
                <TabItem Header="Vue 3D">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                        <Grid ClipToBounds="True">
                            <h:HelixViewport3D x:Name="Viewport" Background="{StaticResource Viewport3DBrush}" ZoomAroundMouseDownPoint="True" ShowViewCube="True" ShowCoordinateSystem="False"
                                               IsHeadLightEnabled="True" ModelUpDirection="0,0,1"
                                               MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave" ShowFrameRate="False">
                                <h:HelixViewport3D.Camera>
                                    <PerspectiveCamera FieldOfView="30" />
                                </h:HelixViewport3D.Camera>
                                <h:DefaultLights />
                                <ModelVisual3D Content="{Binding Scene3D}" />
                            </h:HelixViewport3D>

                            <WrapPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,12,90,12">
                                <Button Style="{StaticResource LightButton}" Content="3/4" Click="CameraIso_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Dessus" Click="CameraTop_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Côté" Click="CameraSide_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Face" Click="CameraFront_Click" />
                                <Button Style="{StaticResource LightButton}" Content="Ajuster" Click="ZoomExtents_Click" />
                                <Button Style="{StaticResource LightButton}" Click="ReplayBuild_Click" Margin="6,0,0,0"
                                        ToolTip="Rejouer la construction : palette, couches déposées une à une, coiffe, cornières, film">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="11" Margin="0,2,6,0" />
                                        <TextBlock Text="Construction" />
                                    </StackPanel>
                                </Button>
                                <ComboBox Width="112" Margin="4,0,0,0" ToolTip="Vitesse de la construction (mémorisée) ; la changer rejoue l'animation"
                                          ItemsSource="{Binding DataContext.BuildSpeeds, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding DataContext.BuildSpeed, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectionChanged="BuildSpeed_Changed" AutomationProperties.Name="Vitesse de la construction" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Label" MinWidth="170" Margin="6,0,0,0"
                                          Visibility="{Binding HasMultipleUnits, Converter={StaticResource BoolToVisibility}}" />
                                <CheckBox Style="{StaticResource FormCheck}" Content="Couleur d'origine" IsChecked="{Binding UseArticleColors}" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="Coché : couleurs des fiches articles. Décoché (par défaut) : couleurs bien distinctes par article, dans l'ordre des lignes (vues 3D et 2D)" />
                            </WrapPanel>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,66" Background="{StaticResource OverlayBrush}" CornerRadius="8" Padding="9,4" IsHitTestVisible="False"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="Clic droit : rotation · molette : zoom · survol : informations · clic : fin de l'animation" />
                            </Border>

                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HoverCard" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" CornerRadius="8"
                                        BorderBrush="{StaticResource PanelDarkBrush}" BorderThickness="1" Padding="10,8" MaxWidth="380">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                    </Border.Effect>
                                    <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap" LineHeight="18" FontSize="12.5" />
                                </Border>
                            </Canvas>

                            <Border VerticalAlignment="Bottom" Margin="12" Padding="12,8" CornerRadius="10" Background="{StaticResource OverlayBrush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Couches visibles" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="70">
                                        <Run Text="{Binding VisibleLayers, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{Binding MaxLayers, Mode=OneWay}" />
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="{Binding MaxLayers}" Value="{Binding VisibleLayers}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Vue 2D">
                    <Grid rc:ResizableColumns.Key="Conditionnements.Vue2D">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="4">
                            <Grid>
                                <ctl:PlanView2D Mode="Top" Solution="{Binding CurrentSolution}" Unit="{Binding CurrentUnit}" Layer="{Binding PlanLayer}"
                                                Constraints="{Binding Constraints}" ColorMap="{Binding ColorMap}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                    <Button Style="{StaticResource LightButton}" Command="{Binding LayerDownCommand}" ToolTip="Couche inférieure">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" />
                                    </Button>
                                    <Button Style="{StaticResource LightButton}" Command="{Binding LayerUpCommand}" ToolTip="Couche supérieure">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" />
                                    </Button>
                                </StackPanel>
                                <Slider VerticalAlignment="Bottom" Margin="70,0,30,8" Minimum="1" Maximum="{Binding MaxLayers}" Value="{Binding PlanLayer}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="4">
                            <ctl:PlanView2D Mode="Side" Solution="{Binding CurrentSolution}" Unit="{Binding CurrentUnit}"
                                            Constraints="{Binding Constraints}" ColorMap="{Binding ColorMap}" />
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0" Padding="4">
                            <ctl:PlanView2D Mode="Front" Solution="{Binding CurrentSolution}" Unit="{Binding CurrentUnit}"
                                            Constraints="{Binding Constraints}" ColorMap="{Binding ColorMap}" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Ordre de pose">
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="12,10,12,6" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Ordre dans lequel poser les produits (unité affichée). Position = coin du produit depuis le coin de la palette (X longueur, Y largeur, Z au-dessus du plateau)." />
                            <DataGrid ItemsSource="{Binding PoseRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N°" Binding="{Binding Sequence}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Article" Binding="{Binding Article}" />
                                    <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*" />
                                    <DataGridTextColumn Header="Couche" Binding="{Binding Layer}" />
                                    <DataGridTextColumn Header="X (mm)" Binding="{Binding X}" />
                                    <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y}" />
                                    <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z}" />
                                    <DataGridTextColumn Header="Enveloppe posée (mm)" Binding="{Binding Size}" />
                                    <DataGridTextColumn Header="Poids (kg)" Binding="{Binding Weight, StringFormat={}{0:0.#####}}" />
                                    <DataGridTextColumn Header="Zone conseillée" Binding="{Binding Zone}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Spécification">
                    <Grid rc:ResizableColumns.Key="Conditionnements.Specification">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="0">
                            <DataGrid x:Name="SpecGrid" RowHeight="NaN" MinRowHeight="30">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelDarkBrush}" Padding="10,5">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Donnée" Binding="{Binding Label}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Valeur" Binding="{Binding Value}" FontWeight="SemiBold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Unité / précision" Binding="{Binding Unit}" Width="1.6*" Foreground="{StaticResource MutedBrush}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="Margin" Value="0,6" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Couches (du haut vers le bas)" FontWeight="SemiBold" Margin="12,10,0,6" />
                                <DataGrid ItemsSource="{Binding LayerRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="N°" Binding="{Binding Index}" />
                                        <DataGridTextColumn Header="Plan" Binding="{Binding Pattern}" />
                                        <DataGridTextColumn Header="Article" Binding="{Binding Article}" />
                                        <DataGridTextColumn Header="Qté" Binding="{Binding Count}" />
                                        <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, StringFormat=0}" />
                                        <DataGridTextColumn Header="H (mm)" Binding="{Binding Height, StringFormat=0}" />
                                        <DataGridCheckBoxColumn Header="Intercalaire" Binding="{Binding SlipSheet}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Détails du calcul">
                    <Grid>
                        <TextBlock Style="{StaticResource Muted}" Text="Calculez puis choisissez une solution : le détail du calcul s'affiche ici."
                                   Margin="6" Visibility="{Binding CurrentSolution, Converter={StaticResource NullToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CopyCalculationCommand}" HorizontalAlignment="Right" Padding="6,2" Margin="0,0,0,4"
                                        Visibility="{Binding CurrentSolution, Converter={StaticResource NotNullToVisibility}}"
                                        ToolTip="Copier tout le détail du calcul (texte) pour le coller dans un courriel ou un document">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,2,6,0" FontSize="11" />
                                        <TextBlock Text="Copier le détail" />
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding CalculationSections}" Margin="2,2,8,2" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===================== Éditeur ===================== -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SoftPanelBrush}" CornerRadius="0,0,10,10" Padding="14,10">
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource RoundedButton}" Command="{Binding ComputeCommand}" Margin="0,0,4,4" ToolTip="F5 · solutions sur la base choisie">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,2,8,0" />
                                    <TextBlock Text="Calculer" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WarningButton}" Command="{Binding ProposeCommand}" Margin="4,0,0,4"
                                    IsEnabled="{Binding IsHomogeneous}" ToolTip="Compare toutes les palettes actives et les assemblages de palettes physiques">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Margin="0,2,8,0" />
                                    <TextBlock Text="Proposer" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0" ToolTip="Ctrl+S · enregistre le conditionnement avec la solution sélectionnée">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,8,0" />
                                <TextBlock Text="Enregistrer avec la solution sélectionnée" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,10"
                              TextBoxBase.TextChanged="Editor_Changed" ToggleButton.Checked="Editor_Changed" ToggleButton.Unchecked="Editor_Changed">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Modifié" FontSize="11" Foreground="{StaticResource WarningTextBrush}" />
                            </Border>
                            <TextBlock Text="Conditionnement" FontSize="17" FontWeight="Bold" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Code *" />
                                <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Code}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Désignation" />
                                <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Name}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="TYPE" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource TileRadio}" GroupName="PackKind" Content="Homogène (mono-article)"
                                         IsChecked="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Homogene}" />
                            <RadioButton Style="{StaticResource TileRadio}" GroupName="PackKind" Content="Hétérogène (multi-articles)"
                                         IsChecked="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Heterogene}" />
                        </StackPanel>

                        <!-- Client : filtre la liste des articles (homogène et lignes hétérogènes) -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CLIENT" />
                        <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Picker.Clients, Converter={StaticResource OwnView}}" SelectedItem="{Binding Picker.Client}"
                                  b:ComboFilter.MinItems="0" AutomationProperties.Name="Client du conditionnement" ToolTip="Limite la liste des articles à ceux du client" />

                        <!-- Contenu homogène -->
                        <StackPanel Visibility="{Binding IsHomogeneous, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ARTICLE" />
                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Picker.Articles, Converter={StaticResource OwnView}}" SelectedItem="{Binding Article}"
                                      ItemTemplate="{StaticResource ArticleItem}" b:ComboFilter.MinItems="0" AutomationProperties.Name="Article du conditionnement" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Article.Designation}" Margin="2,3,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenArticleColisageCommand}" Padding="4,2" Margin="0,0,6,0"
                                        Visibility="{Binding ArticleHasColisage, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Ouvrir l'espace Colisage réglé sur le colisage de cette caisse">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,5,0" FontSize="11" />
                                        <TextBlock Text="Voir le colisage" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenArticleSheetCommand}" Padding="4,2"
                                        Visibility="{Binding Article, Converter={StaticResource NotNullToVisibility}}" ToolTip="Fiche de l'article (espace Articles)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71B;" Margin="0,2,5,0" FontSize="11" />
                                        <TextBlock Text="Fiche article" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding ArticleWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="2,3,0,0" FontSize="11.5"
                                       Visibility="{Binding ArticleWarning, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Quantité imposée par conditionnement (vide = maximum)" />
                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.TargetQuantity, TargetNullValue=''}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Contenu hétérogène -->
                        <StackPanel Visibility="{Binding IsHeterogeneous, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="LIGNES ARTICLE × QUANTITÉ" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LightButton}" Margin="5,0,0,0" ToolTip="Retirer la ligne"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LightButton}" Margin="5,0,0,0" ToolTip="Voir le colisage de cette caisse"
                                                    Visibility="{Binding HasColisage, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.OpenLineColisageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" FontSize="10" />
                                            </Button>
                                            <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Margin="0,2,6,14" Background="{Binding ViewBrush}"
                                                    ToolTip="Couleur de l'article dans les vues" />
                                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Width="86" Margin="5,0,0,0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                     ToolTip="Quantité (jusqu'à plusieurs centaines de milliers)" />
                                            <StackPanel>
                                                <ComboBox Style="{StaticResource FormCombo}" SelectedItem="{Binding Article}" ItemTemplate="{StaticResource ArticleItem}"
                                                          ItemsSource="{Binding DataContext.Picker.Articles, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource OwnView}}"
                                                          b:ComboFilter.MinItems="0" />
                                                <DockPanel Margin="4,1,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding ProfileText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="Profil de gerbage déduit (type, dimensions, poids) : zone conseillée et poids que l'article peut porter" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding AddLineCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                    <TextBlock Text="Ajouter une ligne" />
                                </StackPanel>
                            </Button>
                            <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="8,5" Margin="0,8,0,0">
                                <TextBlock Text="{Binding LinesSummary}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Taux de support minimal (%)" />
                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.MinSupportPercent}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Base -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="PALETTE ET PALETTES PHYSIQUES" />
                        <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Pallets}" SelectedItem="{Binding Pallet}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:PalletThumb Pallet="{Binding}" Width="46" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DimensionsText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Palettes dans la longueur" />
                                <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{StaticResource Counts}" SelectedItem="{Binding CountAlongLength}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Palettes dans la largeur" />
                                <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{StaticResource Counts}" SelectedItem="{Binding CountAlongWidth}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding PalletRotated}" Content="Palette tournée (sa largeur dans la longueur de la base)" />
                        <TextBlock Text="{Binding BaseText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <!-- Axe -->
                        <StackPanel Visibility="{Binding ShowAxis, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="AXE DES TUBES ET BOBINES" />
                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding AxisChoices}" SelectedItem="{Binding Axis}" DisplayMemberPath="Label" />
                        </StackPanel>

                        <!-- Contraintes -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CONTRAINTES" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur totale maxi (mm)" ToolTip="Palette comprise" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.MaxTotalHeight}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Poids maxi charge (kg)" ToolTip="0 = charge dynamique des palettes physiques" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.MaxLoadWeight}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Débord palette autorisé – longueur (mm)"
                                           ToolTip="Dépassement maximal de la charge au-delà de la palette, de chaque côté, dans le sens de la longueur. 0 = aucun débord (défaut). Utilisé seulement si la charge en a besoin ; négatif = retrait imposé." />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.OverhangLength}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Débord palette autorisé – largeur (mm)"
                                           ToolTip="Dépassement maximal de la charge au-delà de la palette, de chaque côté, dans le sens de la largeur. 0 = aucun débord (défaut). Utilisé seulement si la charge en a besoin ; négatif = retrait imposé." />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.OverhangWidth}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Jeu entre produits (mm)" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.Gap}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Constraints.CenterLoad}" Content="Centrer la charge sur la base" />
                        <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Constraints.AllowPartialLayer}" Content="Dernière couche incomplète si le poids limite" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="GERBAGE DES CONDITIONNEMENTS" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabel}" Text="Gerbages maxi (0 = non gerbable)"
                                           ToolTip="Nombre de conditionnements pouvant être gerbés sur le premier : 0 = non gerbable, 1 = un dessus, etc." />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.MaxStacking}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur gerbée maxi (mm)" ToolTip="Camion standard : 2700" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.MaxStackedHeight}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="ACCESSOIRES" />
                        <Expander Header="Intercalaires" IsExpanded="False" Margin="0,2">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Épaisseur (mm)" ToolTip="0 = aucun intercalaire" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.SlipSheetThickness}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Toutes les n couches" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.SlipSheetEvery}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Poids (kg)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.SlipSheetWeight}" />
                                </StackPanel>
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Constraints.SlipSheetOnPallet}"
                                          Content="Aussi sur la palette, sous la première couche" />
                            </Grid>
                        </Expander>
                        <Expander Header="Coiffe / planche de dessus" Margin="0,2">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur (mm)" ToolTip="0 = pas de coiffe" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CapHeight}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Poids (kg)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CapWeight}" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <Expander Margin="0,2" IsExpanded="{Binding Corners, Mode=OneWay}">
                            <Expander.Header>
                                <CheckBox IsChecked="{Binding Corners}" Content="Cornières (coins anti-chute)" />
                            </Expander.Header>
                            <Grid Margin="0,4,0,4" IsEnabled="{Binding Corners}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Épaisseur (mm)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CornerThickness}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Aile (mm)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CornerLeg}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur (0 = charge)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CornerHeight}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Poids unitaire (kg)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.CornerWeight}" />
                                </StackPanel>
                                <CheckBox Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Constraints.CornersFollowTubes}"
                                          ToolTip="Tubes couchés qui dépassent de la palette seulement. Décoché (défaut) : les cornières restent au niveau de la palette, car elles ne tiendraient pas au bout des tubes ; les tubes qui les gênent sont retirés du lit. Coché : les cornières suivent les tubes, comme pour les autres produits.">
                                    <TextBlock Text="Tubes en débord : les cornières suivent les tubes (sinon elles restent au niveau de la palette)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Constraints.CornersInside}"
                                          ToolTip="Coché : la charge est mise en retrait de l'épaisseur des cornières pour qu'elles restent dans l'emprise de la palette (l'encombrement ne dépasse pas). Décoché : cornières à l'extérieur de la charge.">
                                    <TextBlock Text="Cornières contenues dans la palette (charge en retrait de leur épaisseur)" TextWrapping="Wrap" />
                                </CheckBox>
                            </Grid>
                        </Expander>
                        <Expander Header="Film et cerclage" Margin="0,2">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Épaisseur du film (mm)" ToolTip="Ajoutée à l'encombrement de chaque côté" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.FilmThickness}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Nombre de cerclages" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Constraints.Straps}" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Toute modification se prend en compte au prochain « Calculer » (F5)." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
