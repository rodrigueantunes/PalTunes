<UserControl x:Class="PalTunes.App.Views.PalletsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
             xmlns:ctl="clr-namespace:PalTunes.App.Views.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PalletsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="850">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Catalogue ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Palettes" FontSize="17" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Supports physiques : bois, plastique (gris), carton… Les palettes actives sont comparées par l'assistant." TextWrapping="Wrap" />
                    <TextBox Style="{StaticResource SearchBox}" Margin="0,10,0,6" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <WrapPanel Margin="0,2,0,8">
                        <Button Style="{StaticResource RoundedButton}" Command="{Binding NewCommand}" Padding="12,6" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                <TextBlock Text="Nouvelle palette" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DuplicateCommand}" ToolTip="Dupliquer">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DeleteCommand}" ToolTip="Supprimer">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding RestoreCatalogCommand}" ToolTip="Restaurer les palettes du catalogue supprimées">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <ListBox Style="{StaticResource CardListBox}" ItemsSource="{Binding Pallets}" SelectedItem="{Binding SelectedPallet}"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="False">
                    <ListBox.GroupStyle>
                        <GroupStyle />
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ctl:PalletThumb DockPanel.Dock="Left" Pallet="{Binding}" Width="74" Height="30" Margin="0,0,12,0" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#EEF2F5" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Family}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Code, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DimensionsText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Fiche palette ===================== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="20,16,14,14">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Padding="18,8" Margin="0,0,8,0" ToolTip="Ctrl+S">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,8,0" />
                                <TextBlock Text="Enregistrer" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding RefreshPreviewCommand}" Content="Actualiser l'aperçu" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Binding.SourceUpdated="Form_SourceUpdated">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#E8F6F3"
                                        Visibility="{Binding Draft.IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Catalogue" FontSize="11" Foreground="#1E8449" />
                                </Border>
                                <TextBlock FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Draft.Code, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Draft.Name, Mode=OneWay}" FontWeight="Normal" FontSize="14" />
                                </TextBlock>
                            </DockPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="IDENTIFICATION" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Code *" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Code, NotifyOnSourceUpdated=True}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Désignation" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Name, NotifyOnSourceUpdated=True}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Famille" />
                                    <ComboBox Style="{StaticResource FormCombo}" IsEditable="True" ItemsSource="{Binding Families}" Text="{Binding Draft.Family}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Matériau" />
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Materials}" SelectedItem="{Binding Draft.Material, NotifyOnSourceUpdated=True}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Construction (représentation 3D / 2D)" />
                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Constructions}" SelectedItem="{Binding Draft.Construction, NotifyOnSourceUpdated=True}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="DIMENSIONS (mm)" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Longueur *" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Length, NotifyOnSourceUpdated=True}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Largeur *" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Width, NotifyOnSourceUpdated=True}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur de bois *" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Height, NotifyOnSourceUpdated=True}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="MASSES ET CHARGES (kg)" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Tare" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.Tare}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Charge dynamique" ToolTip="Charge admissible en manutention : poids maximal de la charge par défaut" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.DynamicLoad}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Charge statique" ToolTip="Charge admissible au sol (gerbage). 0 = non renseignée" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Draft.StaticLoad}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="REPRÉSENTATION" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0"
                                        Background="{Binding Draft.Color, Converter={StaticResource HexToBrush}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                                <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Color, NotifyOnSourceUpdated=True}" Width="110" HorizontalAlignment="Left" />
                                <ItemsControl ItemsSource="{Binding Swatches}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="20" Height="20" Margin="2" Cursor="Hand" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="5" Background="{Binding Converter={StaticResource HexToBrush}}" BorderBrush="White" BorderThickness="1" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding Draft.Active}" Margin="0,12,0,0"
                                      Content="Active : comparée par l'assistant « Proposer » des conditionnements" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Notes" />
                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Draft.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Top" />

                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="1" Background="#F4F7F9" CornerRadius="0,10,10,0">
                    <Grid Margin="14">
                        <h:HelixViewport3D x:Name="Preview" Background="#F4F7F9" ShowViewCube="True"
                                           IsHeadLightEnabled="True" ModelUpDirection="0,0,1">
                            <h:DefaultLights />
                            <ModelVisual3D Content="{Binding Preview}" />
                        </h:HelixViewport3D>
                        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource Muted}"
                                   Text="Clic droit : rotation · molette : zoom" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
