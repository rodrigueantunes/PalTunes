<UserControl x:Class="PalTunes.App.Views.PackagingLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PackagingLibraryViewModel}"
             d:DesignWidth="1300" d:DesignHeight="850">
    <Grid rc:ResizableColumns.Key="Gestion">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Arborescence ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding CountText}" VerticalAlignment="Center" />
                        <TextBlock Text="Gestion des conditionnements" FontSize="17" FontWeight="Bold" />
                    </DockPanel>
                    <TextBox Style="{StaticResource SearchBox}" Margin="0,10,0,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Recherche sur le code, le nom, le client, la famille, les articles…" />
                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}"
                              DisplayMemberPath="Label" ToolTip="Rangement de l'arborescence (comme les articles)" />
                    <WrapPanel Margin="0,8,0,6">
                        <Button Style="{StaticResource LightButton}" Command="{Binding ExpandAllCommand}" ToolTip="Tout déplier">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding CollapseAllCommand}" ToolTip="Tout replier">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <TreeView ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick" VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,1" ToolTip="{Binding Detail}">
                                <Border DockPanel.Dock="Right" Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Grid DockPanel.Dock="Left" Width="18" Margin="0,0,7,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            Visibility="{Binding IsGroup, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="9" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                </StackPanel>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ===================== Fiche ===================== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,16,20,8">
                    <TextBlock Style="{StaticResource Muted}" Text="Choisissez un conditionnement dans l'arborescence."
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource PrimarySoftBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}" FontSize="13" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Client" />
                            <TextBlock Grid.Column="1" Text="{Binding ClientText}" Margin="0,6,0,2" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Contenu" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContentText}" TextWrapping="Wrap" Margin="0,6,0,2" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Palette" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PalletText}" Margin="0,6,0,2" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Solution enregistrée" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SolutionText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,2" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Colisage"
                                       Visibility="{Binding HasColisageLink, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ColisageText}" TextWrapping="Wrap" Margin="0,6,0,2"
                                       Visibility="{Binding HasColisageLink, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Dates" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding DatesText}" Margin="0,6,0,2" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <h:HelixViewport3D x:Name="Preview" Grid.Row="1" Background="{StaticResource Viewport3DBrush}" ZoomAroundMouseDownPoint="True" ShowViewCube="True" IsHeadLightEnabled="True" ModelUpDirection="0,0,1">
                    <h:HelixViewport3D.Camera>
                        <PerspectiveCamera FieldOfView="30" />
                    </h:HelixViewport3D.Camera>
                    <h:DefaultLights />
                    <ModelVisual3D Content="{Binding Preview}" />
                </h:HelixViewport3D>
                <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Style="{StaticResource Muted}"
                           Text="Solution enregistrée, première unité · clic droit : rotation · molette : zoom" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource RoundedButton}" Command="{Binding OpenCommand}" Padding="16,8" Margin="0,0,8,0"
                            ToolTip="Ouvrir dans l'écran des conditionnements (calcul, vues, impression) ; double-clic dans l'arborescence">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,6,0" />
                            <TextBlock Text="Ouvrir" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ColisageButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="ColisageButton_Click"
                            Visibility="{Binding HasColisageLink, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Ouvrir l'espace Colisage réglé sur le colisage de la caisse (produit, caisse, quantité par caisse)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding ColisageButtonText}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Colisages}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="Command" Value="{Binding DataContext.OpenColisageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="Padding" Value="8,5" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenArticleCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsHomogeneousSelection, Converter={StaticResource BoolToVisibility}}" ToolTip="Fiche de l'article (espace Articles)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71B;" Margin="0,2,6,0" />
                            <TextBlock Text="Voir l'article" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding DuplicateCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,2,6,0" />
                            <TextBlock Text="Dupliquer" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,2,6,0" />
                            <TextBlock Text="Supprimer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
