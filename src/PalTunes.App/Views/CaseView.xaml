<UserControl x:Class="PalTunes.App.Views.CaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
             xmlns:ctl="clr-namespace:PalTunes.App.Views.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CaseViewModel}"
             d:DesignWidth="1300" d:DesignHeight="850">
    <UserControl.Resources>
        <DataTemplate x:Key="CaseItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding InnerText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Paramètres / catalogue ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="6" Padding="10,12">
            <TabControl>
                <TabItem Header="Mise en caisse">
                    <DockPanel Margin="4,4,4,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Style="{StaticResource RoundedButton}" Command="{Binding ComputeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,2,8,0" />
                                    <TextBlock Text="Calculer le colisage" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding CreateCaseArticleCommand}"
                                    ToolTip="Ajoute à la base un article « Caisse » : dimensions extérieures, poids = produits + tare">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,8,0" />
                                    <TextBlock Text="Créer l'article caisse" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SuccessButton}" Command="{Binding CreateAndPalletizeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Margin="0,2,8,0" />
                                    <TextBlock Text="Créer et palettiser la caisse" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding DataContext.PrintCaseSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Fiche de colisage du résultat affiché (produit, caisse, quantité par caisse, plans, vue 3D)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" Margin="0,2,8,0" />
                                    <TextBlock Text="Imprimer la fiche de colisage" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Combien de produits dans une caisse ? Mêmes plans de couche optimaux que la palettisation ; la caisse obtenue devient un article à palettiser." />

                                <TextBlock Style="{StaticResource SectionTitle}" Text="PRODUIT À METTRE EN CAISSE" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="Client" Margin="0,0,0,2" />
                                <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Picker.Clients, Converter={StaticResource OwnView}}" SelectedItem="{Binding Picker.Client}"
                                          b:ComboFilter.MinItems="0" ToolTip="Limite la liste des produits à ceux du client" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="Produit" />
                                <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Picker.Articles, Converter={StaticResource OwnView}}" SelectedItem="{Binding Article}"
                                          b:ComboFilter.MinItems="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DimensionsText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Designation}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" Margin="2,3,0,0">
                                    <Run Text="{Binding Article.KindLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Article.Weight, Mode=OneWay, StringFormat={}{0:0.#####} kg}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ArticleWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="2,4,0,0" FontSize="11.5"
                                           Visibility="{Binding ArticleWarning, Converter={StaticResource NotNullToVisibility}}" />
                                <StackPanel Visibility="{Binding ShowAxis, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Axe des tubes dans la caisse" />
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding AxisChoices}" SelectedItem="{Binding AxisChoice}" DisplayMemberPath="Label"
                                              ToolTip="Comme en palettisation : debout (axe vertical) et couché (axe horizontal) sont calculés, le meilleur est recommandé ; ou un axe imposé" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="PALETTE DE DESTINATION" />
                                <Grid IsEnabled="{Binding IsPalletChoiceEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Pallets}" SelectedItem="{Binding DestinationPallet}" VerticalAlignment="Bottom"
                                              ToolTip="La meilleure caisse est celle qui donne le plus de produits sur cette palette">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:PalletThumb Pallet="{Binding}" Width="40" Height="16" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DimensionsText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur maxi (mm)" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource NumBox}" Text="{Binding PalletMaxHeight}" ToolTip="Hauteur totale maxi, palette comprise" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" IsEnabled="{Binding IsPalletChoiceEnabled}">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Débord autorisé – longueur (mm)" ToolTip="Par côté ; 0 = aucun débord" />
                                        <TextBox Style="{StaticResource NumBox}" Text="{Binding PalletOverhangLength}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Débord autorisé – largeur (mm)" ToolTip="Par côté ; 0 = aucun débord" />
                                        <TextBox Style="{StaticResource NumBox}" Text="{Binding PalletOverhangWidth}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Muted}" Margin="2,3,0,0" Text="Caisse forcée : la palette de destination n'est pas prise en compte."
                                           Visibility="{Binding IsPalletChoiceEnabled, Converter={StaticResource InverseBoolToVisibility}}" />

                                <TextBlock Style="{StaticResource SectionTitle}" Text="CAISSE" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="CaseMode" ToolTip="Compare toutes les caisses actives du catalogue et recommande la meilleure"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Best}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE734;" Margin="0,2,6,0" />
                                            <TextBlock Text="La meilleure" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="CaseMode" ToolTip="Choisir une caisse du catalogue (seules les caisses possibles pour l'article)"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Catalog}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Margin="0,2,6,0" />
                                            <TextBlock Text="Du catalogue" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="CaseMode" ToolTip="Saisir les caractéristiques d'une caisse spécifique"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Custom}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Margin="0,2,6,0" />
                                            <TextBlock Text="Spécifique" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <DockPanel Margin="2,2,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4,0" Content="Gérer le catalogue des caisses"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CaseTypes" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding PossibleText}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding Mode, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Best}">
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Width="70" Text="{Binding ManualLimit}" />
                                    <TextBlock Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Text="Poids brut maxi en manutention manuelle (kg) : les caisses plus lourdes passent après (0 = ignoré)" />
                                </DockPanel>

                                <!-- Caisse du catalogue -->
                                <StackPanel Visibility="{Binding IsCatalogMode, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding CaseChoices}" SelectedItem="{Binding SelectedCase}"
                                              ItemTemplate="{StaticResource CaseItem}" />
                                    <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding ForceCase}"
                                              ToolTip="Coché : tout le catalogue est proposé (même les caisses non recommandées ou trop petites) et la caisse choisie est imposée.">
                                        <TextBlock Text="Forcer la caisse (choisir dans tout le catalogue)" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                                <Border Background="#F4F7F9" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding CaseInfo, Converter={StaticResource NotNullToVisibility}}">
                                    <TextBlock Text="{Binding CaseInfo}" TextWrapping="Wrap" FontSize="12" />
                                </Border>

                                <!-- Caisse spécifique -->
                                <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="DIMENSIONS INTÉRIEURES (mm)" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Longueur" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.InnerLength}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Largeur" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.InnerWidth}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Hauteur" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.InnerHeight}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="PAROI ET MASSES" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Paroi (mm)" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.WallThickness}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Tare (kg)" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.Tare}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Poids maxi (kg)" ToolTip="0 = non limité" />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding Spec.MaxWeight}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Jeu entre produits (mm)" />
                                        <TextBox Style="{StaticResource NumBox}" Text="{Binding Gap}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Quantité imposée (vide = maxi)" />
                                        <TextBox Style="{StaticResource NumBox}" Text="{Binding TargetQuantity, TargetNullValue=''}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenArticleCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding ShowFixArticle, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Ouvre la fiche de l'article (poids, dimensions, axe) dans l'espace Articles">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Margin="0,2,6,0" />
                                        <TextBlock Text="Corriger la fiche article" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Border>

        <!-- ===================== Solutions et vues ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="6" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8">
                        <Run Text="Solutions" /> <Run Text="{Binding Solutions.Count, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="Calcul en cours…" Style="{StaticResource Muted}" Margin="0,0,0,6"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox Style="{StaticResource HCardListBox}" ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" MinHeight="40">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="230">
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessBrush}" Margin="0,0,0,3"
                                            Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="★ Recommandée" FontSize="10.5" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BaseLabel}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PalletLine}" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PalletLine}" Visibility="{Binding PalletLine, Converter={StaticResource NotNullToVisibility}}" />
                                    <TextBlock Text="{Binding Details}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Orientation}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Margin="8,0,8,4" Padding="12,8" CornerRadius="10" Background="#E9F7EF"
                    Visibility="{Binding Summary, Converter={StaticResource NotNullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSolution.Solution.Recommendation}" TextWrapping="Wrap" Foreground="#1E8449" FontWeight="SemiBold"
                               Visibility="{Binding SelectedSolution.Solution.Recommendation, Converter={StaticResource NotNullToVisibility}}" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#1E8449" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="8,4,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="0">
                    <Grid ClipToBounds="True">
                        <h:HelixViewport3D x:Name="Viewport" Background="{StaticResource Viewport3DBrush}" ZoomAroundMouseDownPoint="True" ShowViewCube="True" IsHeadLightEnabled="True" ModelUpDirection="0,0,1">
                            <h:HelixViewport3D.Camera>
                                <PerspectiveCamera FieldOfView="30" />
                            </h:HelixViewport3D.Camera>
                            <h:DefaultLights />
                            <ModelVisual3D Content="{Binding Scene3D}" />
                        </h:HelixViewport3D>
                        <Button Style="{StaticResource RoundedButton}" Command="{Binding ToggleOpenCommand}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12" Padding="14,7" ToolTip="Ouverte : contenu visible en 3D et plan intérieur en 2D. Fermée : vue extérieure.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,8,0" />
                                <TextBlock Text="{Binding OpenButtonText}" />
                            </StackPanel>
                        </Button>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,110,0" Style="{StaticResource Muted}"
                                   Text="Clic droit : rotation · molette : zoom" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="4">
                    <ctl:PlanView2D Mode="Top" Solution="{Binding CurrentSolution}" Unit="{Binding CurrentUnit}" Layer="1"
                                    Constraints="{Binding Constraints}" ColorMap="{Binding ColorMap}"
                                    CaseClosed="{Binding IsClosed}" CaseWall="{Binding CurrentSpec.WallThickness}" CaseColor="{Binding CurrentCaseColor}" />
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0" Padding="4">
                    <ctl:PlanView2D Mode="Side" Solution="{Binding CurrentSolution}" Unit="{Binding CurrentUnit}"
                                    Constraints="{Binding Constraints}" ColorMap="{Binding ColorMap}"
                                    CaseClosed="{Binding IsClosed}" CaseWall="{Binding CurrentSpec.WallThickness}" CaseColor="{Binding CurrentCaseColor}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
