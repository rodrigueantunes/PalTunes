<Window x:Class="PalTunes.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
        xmlns:views="clr-namespace:PalTunes.App.Views"
        xmlns:ctl="clr-namespace:PalTunes.App.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding AppVersion, StringFormat=PalTunes {0} – Palettisation et conditionnement}"
        Height="900" Width="1500" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/PalTunes;component/Assets/PalTunes.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Packagings.ComputeCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCurrentCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding Print.PalletSheetCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPackagingsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportArticlesCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowFormatHelpCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Clients" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Articles" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Pallets" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="CaseTypes" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Packagings" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Cases" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="PackagingLibrary" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding GoForwardCommand}" />
        <KeyBinding Key="F1" Modifiers="Control" Command="{Binding ToggleShortcutsCommand}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}" />
    </Window.InputBindings>

    <Grid ctl:ResizableColumns.Key="Navigation">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="420" />
            <ColumnDefinition Width="*" MinWidth="700" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation ===================== -->
        <Border Grid.Column="0" Background="{StaticResource NavPanelBrush}">
            <DockPanel Margin="10,14,10,10">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,14">
                    <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="46" Height="46" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PalTunes" Foreground="White" FontSize="22" FontWeight="Bold" />
                            <Button Command="{Binding ShowReleaseNotesCommand}" Cursor="Hand" Margin="6,5,0,0" VerticalAlignment="Top"
                                    ToolTip="Nouveautés de la version" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{Binding AppVersion}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Palettisation · conditionnement" Foreground="#AEB6BF" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NavMiniButton}" Command="{Binding GoForwardCommand}" ToolTip="{Binding ForwardTip}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Écran suivant">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="12" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource NavMiniButton}" Command="{Binding GoBackCommand}" ToolTip="{Binding BackTip}"
                            ToolTipService.ShowOnDisabled="True" Margin="0,0,4,0" AutomationProperties.Name="Écran précédent">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource NavSearchButton}" Command="{Binding OpenSearchCommand}" Margin="0,0,6,0"
                            ToolTip="Rechercher partout : articles, conditionnements, colisages, clients, palettes, caisses (Ctrl+K)" AutomationProperties.Name="Rechercher">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="12" Margin="0,1,8,0" />
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="10.5" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Text="Rechercher…" />
                        </DockPanel>
                    </Button>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,0,0">
                    <Button Style="{StaticResource NavLinkButton}" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Ctrl+Maj+D · mémorisé pour les prochaines ouvertures">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ThemeGlyph}" FontSize="11" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding ThemeLabel}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavLinkButton}" Command="{Binding ToggleAnimationsCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Construction des palettes, ouverture des caisses, transitions ; mémorisé">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="11" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding AnimationsLabel}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavLinkButton}" Command="{Binding ToggleShortcutsCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Ctrl+F1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE765;" FontSize="11" Margin="0,1,6,0" />
                            <TextBlock Text="Raccourcis clavier" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <TextBlock Foreground="{StaticResource NavMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabasePath}">
                        <Run Text="Base : " /><Run Text="{Binding DatabaseName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NavHeader}" Text="ESPACES" Margin="12,0,0,4" />
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+1 · coordonnées et exigences de conditionnement"
                                     AutomationProperties.Name="Espace Clients" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=Clients}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource NavBadgeBrush}" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding ClientCount}" FontSize="11" Foreground="#ECF0F1" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" Margin="0,2,10,0" />
                                <TextBlock Text="Clients" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+2"
                                     AutomationProperties.Name="Espace Articles" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=Articles}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource NavBadgeBrush}" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding ArticleCount}" FontSize="11" Foreground="#ECF0F1" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,10,0" />
                                <TextBlock Text="Articles" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+3"
                                     AutomationProperties.Name="Espace Palettes" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=Pallets}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource NavBadgeBrush}" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding PalletCount}" FontSize="11" Foreground="#ECF0F1" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80A;" Margin="0,2,10,0" />
                                <TextBlock Text="Palettes" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+4 · catalogue des caisses (cartons, bacs, caisses bois)"
                                     AutomationProperties.Name="Espace Caisses" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=CaseTypes}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource NavBadgeBrush}" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding CaseCount}" FontSize="11" Foreground="#ECF0F1" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,10,0" />
                                <TextBlock Text="Caisses" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+5"
                                     AutomationProperties.Name="Espace Conditionnements" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=Packagings}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource NavBadgeBrush}" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding PackagingCount}" FontSize="11" Foreground="#ECF0F1" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Margin="0,2,10,0" />
                                <TextBlock Text="Conditionnements" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+7 · tous les conditionnements, rangés par client, famille, type"
                                     AutomationProperties.Name="Espace Gestion des conditionnements" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=PackagingLibrary}">
                            <DockPanel>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" Margin="0,2,10,0" />
                                <TextBlock Text="Gestion des conditionnements" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Section" ToolTip="Ctrl+6 · produits dans une caisse, puis article caisse à palettiser"
                                     AutomationProperties.Name="Espace Colisage" IsChecked="{Binding SelectedSection, Converter={StaticResource Equals}, ConverterParameter=Cases}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,10,0" />
                                <TextBlock Text="Colisage (caisses)" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Style="{StaticResource NavHeader}" Text="CLIENTS" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding ImportClientsCommand}" ToolTip="Un code client existant est mis à jour ; deux clients peuvent porter le même nom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,10,0" />
                                <TextBlock Text="Importer les clients (CSV)" />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource NavHeader}" Text="ARTICLES" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding ImportArticlesCommand}" ToolTip="Ctrl+I · même code chez le même client : mis à jour ; rapport ligne par ligne">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,10,0" />
                                <TextBlock Text="Importer (CSV)" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource NavButton}" Command="{Binding ExportTemplateCommand}"
                                    ToolTip="Toutes les colonnes et une ligne d'exemple par type d'article">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Margin="0,2,10,0" />
                                    <TextBlock Text="Modèle CSV" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,12,0"
                                    Command="{Binding ShowFormatHelpCommand}" ToolTip="F1 · colonnes du fichier et données minimales par type" />
                        </Grid>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ExportArticlesCommand}" ToolTip="Même format que l'import (réimportable)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDE1;" Margin="0,2,10,0" />
                                <TextBlock Text="Exporter la base" />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource NavHeader}" Text="CONDITIONNEMENTS" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding ExportPackagingsCommand}"
                                ToolTip="Ctrl+E · spécification des conditionnements mono-article (produits, palettes physiques, gerbages, palette, charge, encombrement)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,10,0" />
                                <TextBlock Text="Exporter (mono-article)" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Print.ArticleText}" Foreground="{StaticResource NavMutedBrush}" FontSize="11" Margin="12,0,8,4"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Print.ArticleText}" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding Print.PalletSheetCommand}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding Print.PalletTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" Margin="0,2,10,0" />
                                <TextBlock Text="Imprimer la fiche palette" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding Print.CaseSheetCommand}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding Print.CaseTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding Print.CaseSheetLabel}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding Print.PackagingSheetCommand}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding Print.PackagingTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" Margin="0,2,10,0" />
                                <TextBlock Text="Imprimer la fiche de conditionnement" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Expander Style="{StaticResource NavExpander}" Header="BASE DE DONNÉES">
                            <StackPanel>
                                <Button Style="{StaticResource NavButton}" Command="{Binding OpenDatabaseCommand}" Padding="12,6"
                                        ToolTip="Ouvrir une autre base (fichier partagé sur le réseau par exemple)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,2,10,0" FontSize="11" />
                                        <TextBlock Text="Ouvrir une base…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Command="{Binding NewDatabaseCommand}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,10,0" FontSize="11" />
                                        <TextBlock Text="Nouvelle base…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Command="{Binding ResetDatabaseCommand}" Padding="12,6"
                                        ToolTip="Vide la base courante (sauvegarde automatique avant) et remet les catalogues de palettes et de caisses par défaut">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Margin="0,2,10,0" FontSize="11" />
                                        <TextBlock Text="Réinitialiser la base…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Command="{Binding ShowDatabaseFolderCommand}" Padding="12,6" ToolTip="{Binding DatabasePath}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" Margin="0,2,10,0" FontSize="11" />
                                        <TextBlock Text="Afficher le fichier" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Espaces ===================== -->
        <Grid Grid.Column="1" Margin="4">
            <views:ClientsView ctl:Motion.Appear="Slide" DataContext="{Binding Clients}"
                               Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Clients}" />
            <views:ArticlesView ctl:Motion.Appear="Slide" DataContext="{Binding Articles}"
                                Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Articles}" />
            <views:PalletsView ctl:Motion.Appear="Slide" DataContext="{Binding Pallets}"
                               Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pallets}" />
            <views:CaseTypesView ctl:Motion.Appear="Slide" DataContext="{Binding Cases}"
                                 Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=CaseTypes}" />
            <views:CaseView ctl:Motion.Appear="Slide" DataContext="{Binding Cases}"
                            Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Cases}" />
            <views:PackagingLibraryView ctl:Motion.Appear="Slide" DataContext="{Binding PackagingLibrary}"
                                        Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=PackagingLibrary}" />
            <views:PackagingsView ctl:Motion.Appear="Slide" DataContext="{Binding Packagings}"
                                  Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Packagings}" />
        </Grid>

        <!-- Notification -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CloseToastCommand}" Foreground="#BDC3C7"
                        Margin="10,0,0,0" Padding="4,2">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                </Button>
                <Ellipse x:Name="ToastDot" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastKind}" Value="Ok">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ToastText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>

        <!-- Rapport d'import -->
        <Border Grid.ColumnSpan="2" Background="#9922313F" ctl:Motion.Appear="Fade" Visibility="{Binding ImportReport, Converter={StaticResource NotNullToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ctl:Motion.Appear="Pop" Width="820" Padding="26,22" MaxHeight="760">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Rapport d'import" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="{Binding ImportReport.Summary}" />
                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding ImportReport.UnknownColumns.Count, Converter={StaticResource NotNullToVisibility}}">
                            <Run Text="Colonnes ignorées (non reconnues) : " /><Run Text="{Binding ImportReport.UnknownColumns.Count, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RoundedButton}" Command="{Binding CloseImportReportCommand}"
                            HorizontalAlignment="Right" Padding="22,8" Margin="0,14,0,0" Content="Fermer" />
                    <DataGrid ItemsSource="{Binding ImportReport.Lines}" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ligne" Binding="{Binding Row}" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                            <DataGridTemplateColumn Header="Statut">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Détail" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Aide : format du fichier articles -->
        <Border Grid.ColumnSpan="2" Background="#9922313F" ctl:Motion.Appear="Fade" Visibility="{Binding IsFormatHelpOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ctl:Motion.Appear="Pop" Width="1040" Padding="28,22" MaxHeight="840">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Import CSV des articles" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                   Text="Une ligne d'en-tête puis une ligne par article. Séparateur « ; », « , » ou tabulation détecté ; décimales « , » ou « . » ; accents et casse des en-têtes indifférents. Un article existant (même code pour le même client) est mis à jour, seules les colonnes présentes sont modifiées ; la colonne CLIENT contient le code client. Carton plié : LONGUEUR_PLIEE, LARGEUR_PLIEE, HAUTEUR_PLIEE remplacent chacune la dimension montée pour le conditionnement." />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RoundedButton}" Command="{Binding EscapeCommand}"
                            HorizontalAlignment="Right" Padding="22,8" Margin="0,14,0,0" Content="Fermer" />
                    <TabControl>
                        <TabItem Header="Colonnes">
                            <DataGrid ItemsSource="{Binding ImportColumns}" MaxHeight="560" RowHeight="NaN">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Colonne" Binding="{Binding Name}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Exigence" Binding="{Binding Requirement}" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="Margin" Value="0,5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Synonymes acceptés" Binding="{Binding Aliases.Length}" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Exemple" Binding="{Binding Example}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Données minimales par type">
                            <DataGrid ItemsSource="{Binding KindDocs}" MaxHeight="560" RowHeight="NaN">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Label}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Obligatoire" Binding="{Binding Required}" Width="260">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="Margin" Value="0,5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Facultatif" Binding="{Binding Optional}" />
                                    <DataGridTextColumn Header="Règle de calcul" Binding="{Binding Description}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="Margin" Value="0,5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

        <!-- Recherche globale (Ctrl+K) -->
        <Border Grid.ColumnSpan="2" Background="#9922313F" ctl:Motion.Appear="Fade" Visibility="{Binding Search.IsOpen, Converter={StaticResource BoolToVisibility}}"
                MouseLeftButtonDown="SearchBackdrop_MouseLeftButtonDown">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" ctl:Motion.Appear="Pop" Margin="0,90,0,0" Width="720" Padding="0"
                    MouseLeftButtonDown="SearchCard_MouseLeftButtonDown" DataContext="{Binding Search}">
                <DockPanel MaxHeight="620">
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="18" Margin="0,4,12,0"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" BorderThickness="0" Background="Transparent"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.Name="Rechercher dans toute la base" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorderBrush}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11.5" Margin="18,6,18,10" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="18,6,18,0"
                               Text="↑ ↓ pour choisir · Entrée pour ouvrir · Échap pour fermer" />
                    <ListBox x:Name="SearchResults" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" BorderThickness="0" Margin="6,6,6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="SearchResults_MouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="15" Width="26" Margin="0,3,6,0"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                    <Border DockPanel.Dock="Right" Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="8,1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
        <!-- Raccourcis clavier -->
        <Border Grid.ColumnSpan="2" Background="#9922313F" ctl:Motion.Appear="Fade" Visibility="{Binding IsShortcutsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ctl:Motion.Appear="Pop" Width="680" Padding="26,22">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Text="Raccourcis clavier" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RoundedButton}" Command="{Binding ToggleShortcutsCommand}"
                            HorizontalAlignment="Right" Padding="22,8" Margin="0,14,0,0" Content="Fermer" />
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="170" Margin="0,0,14,0">
                                        <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="SemiBold" />
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding Action}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Border>
        <!-- Nouveautés de la version -->
        <Border Grid.ColumnSpan="2" Background="#9922313F" ctl:Motion.Appear="Fade" Visibility="{Binding IsReleaseNotesOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ctl:Motion.Appear="Pop" Width="680" Padding="28,24" MaxHeight="780">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="60" Height="60" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}">
                                <Run Text="Nouveautés de PalTunes " /><Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Palettisation homogène et hétérogène de tous types de produits." />
                        </StackPanel>
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource RoundedButton}" Command="{Binding CloseReleaseNotesCommand}"
                            HorizontalAlignment="Right" Padding="22,9" Margin="0,16,0,0" Content="C'est parti" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReleaseNotesList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,10,0">
                                                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="11.5"><Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="11"
                                                                       Foreground="{StaticResource SuccessBrush}" Margin="2,3,10,0" />
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
