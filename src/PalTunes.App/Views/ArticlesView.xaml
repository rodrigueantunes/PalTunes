<UserControl x:Class="PalTunes.App.Views.ArticlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:b="clr-namespace:PalTunes.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:vm="clr-namespace:PalTunes.App.ViewModels"
             xmlns:m="clr-namespace:PalTunes.Core.Models;assembly=PalTunes.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ArticlesViewModel}"
             d:DesignWidth="1300" d:DesignHeight="850">
    <Grid rc:ResizableColumns.Key="Articles">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Arborescence ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding CountText}" VerticalAlignment="Center" />
                        <TextBlock Text="Base articles" FontSize="17" FontWeight="Bold" />
                    </DockPanel>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Margin="0,10,0,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Recherche sur le code, la désignation, le client, la famille, l'EAN, les dimensions…" />
                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}"
                              DisplayMemberPath="Label" ToolTip="Regroupement de l'arborescence" />
                    <WrapPanel Margin="0,8,0,6">
                        <Button x:Name="NewButton" Style="{StaticResource RoundedButton}" Padding="12,6" Margin="0,0,6,0" Click="NewButton_Click"
                                ToolTip="Créer un article : choisir son type">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                <TextBlock Text="Nouvel article" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="9" Margin="6,4,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding Kinds}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Converter={StaticResource EnumLabel}}" />
                                            <Setter Property="Command" Value="{Binding DataContext.NewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="Padding" Value="8,5" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DuplicateCommand}" ToolTip="Dupliquer l'article sélectionné">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding DeleteCommand}" ToolTip="Supprimer l'article sélectionné">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding ExpandAllCommand}" ToolTip="Tout déplier">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" />
                        </Button>
                        <Button Style="{StaticResource LightButton}" Command="{Binding CollapseAllCommand}" ToolTip="Tout replier">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <TreeView ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="Tree_SelectedItemChanged" VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,1" ToolTip="{Binding Detail}">
                                <Border DockPanel.Dock="Right" Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Grid DockPanel.Dock="Left" Width="18" Margin="0,0,7,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            Visibility="{Binding IsGroup, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="9" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </StackPanel>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ===================== Fiche article ===================== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6" Padding="0">
            <Grid rc:ResizableColumns.Key="Articles.Fiche">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="20,16,10,14">
                    <!-- Barre d'actions -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,-6">
                        <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Padding="18,8" Margin="0,0,8,6" ToolTip="Ctrl+S">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,2,8,0" />
                                <TextBlock Text="Enregistrer" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" Content="Annuler les modifications" Margin="0,0,8,0" />
                        <Button Style="{StaticResource RoundedButton}" Command="{Binding PalletizeCommand}" Padding="14,8"
                                ToolTip="Créer un conditionnement homogène pour cet article et calculer les solutions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Margin="0,2,8,0" />
                                <TextBlock Text="Palettiser cet article" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding PackInCaseCommand}" Margin="8,0,0,6"
                                ToolTip="Espace Colisage : combien de produits dans une caisse">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,6,0" />
                                <TextBlock Text="Mettre en caisse" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ColisageButton" Style="{StaticResource OutlineButton}" Command="{Binding OpenColisageCommand}" Margin="8,0,0,6"
                                Visibility="{Binding HasColisages, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Colisages de cet article : ouvert directement s'il n'y en a qu'un, sinon liste à filtrer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,6,0" />
                                <TextBlock Text="{Binding ColisageButtonText}" />
                            </StackPanel>
                        </Button>
                        <Popup IsOpen="{Binding IsColisagePickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ColisageButton}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" Opened="ColisagePopup_Opened">
                            <Border Style="{StaticResource CardStyle}" Width="460" Padding="10" Margin="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ColisagePickerTitle}" FontWeight="SemiBold" Margin="2,0,0,6"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBox x:Name="ColisageFilterBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}"
                                             Text="{Binding ColisageFilter, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ColisageFilter_PreviewKeyDown"
                                             AutomationProperties.Name="Filtrer les colisages" ToolTip="Filtrer : code de la caisse, produit, caisse du catalogue" />
                                    <ListBox x:Name="ColisageList" ItemsSource="{Binding FilteredColisages}" MaxHeight="320" Margin="0,6,0,0"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseLeftButtonUp="ColisageList_MouseLeftButtonUp" KeyDown="ColisageList_KeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2,3">
                                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7B8;" Margin="0,2,8,0"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding ShowPackagingsCommand}" Margin="8,0,0,6"
                                Visibility="{Binding HasPackagings, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Gestion des conditionnements filtrée sur cet article (palettes de l'article et des caisses qui le contiennent)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Margin="0,2,6,0" />
                                <TextBlock Text="{Binding PackagingsButtonText}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel DataContext="{Binding Editor}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Modifié – non enregistré" FontSize="11" Foreground="{StaticResource WarningTextBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="TYPE D'ARTICLE" />
                            <ListBox ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     SelectedItem="{Binding Kind}" Style="{StaticResource PillListBox}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Converter={StaticResource KindGlyph}}" Margin="0,2,6,0" />
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding KindDescription}" TextWrapping="Wrap" Margin="2,2,0,0" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="IDENTIFICATION" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Code article *" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Désignation" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Designation}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="DONNÉES DE CALCUL (obligatoires selon le type)" />
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowLength, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding LengthLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Length}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowWidth, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding WidthLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Width}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowHeight, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HeightLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Height}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowDiameter, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding DiameterLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Diameter}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowInnerDiameter, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding InnerDiameterLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding InnerDiameter}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Poids unitaire (kg) *" ToolTip="Jusqu'à 5 décimales (0,00001 kg)" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding Weight, StringFormat={}{0:0.#####}}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Visibility="{Binding ShowFoldedHeight, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Carton livré plié (à plat) : chaque dimension pliée renseignée (> 0) remplace la dimension montée pour la palettisation et le colisage">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding FoldedLengthLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding FoldedLength}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding FoldedWidthLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding FoldedWidth}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding FoldedHeightLabel}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding FoldedHeight}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Visibility="{Binding ShowQuantityPerCase, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Facultatif : nombre de produits dans la caisse. Renseigné à la création d'une caisse au colisage ; la fiche palette indique alors aussi les produits par palette.">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Quantité par caisse" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding QuantityPerCase, TargetNullValue=''}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding CaseContentText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding CaseContentText, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Text="{Binding DataContext.WeightWarning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding DataContext.WeightWarning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotNullToVisibility}}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Visibility="{Binding UsesOrientation, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Orientation" />
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Visibility="{Binding UsesCoilAxis, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Axe autorisé (forçable par conditionnement)" />
                                    <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Axes}" SelectedItem="{Binding CoilAxis}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="CONTRAINTES DE GERBAGE (facultatives)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Charge maxi sur le dessus (kg)"
                                               ToolTip="Poids qu'un exemplaire peut supporter (résistance du carton, du bac…). Vide = non limité." />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding MaxLoadOnTop, TargetNullValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Couches maxi" ToolTip="Nombre maximal de couches superposées. Vide = non limité." />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding MaxLayers, TargetNullValue=''}" />
                                </StackPanel>
                                <CheckBox Grid.Column="4" Style="{StaticResource FormCheck}" IsChecked="{Binding Fragile}" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                          Content="Fragile (rien dessus)" />
                            </Grid>

                            <!-- Forme du dessus et poignée : bidon, seau, bouteille, fût -->
                            <StackPanel Visibility="{Binding ShowTopShape, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="FORME DU DESSUS ET POIGNÉE (gerbage)" />

                                <!-- Dessus -->
                                <DockPanel Visibility="{Binding HasTopShape, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding DefineTopShapeCommand}" Margin="8,0,0,0"
                                            ToolTip="Décrire le dessus (droit ou arrondi, angle) : le calcul décide s'il est gerbable directement, sur intercalaire ou pas du tout">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Margin="0,2,6,0" />
                                            <TextBlock Text="Décrire le dessus" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Dessus non décrit." />
                                </DockPanel>
                                <Grid Visibility="{Binding HasTopShape, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Dessus" ToolTip="Droit : un plan (plat ou incliné). Arrondi : bombé, seule la partie haute porte." />
                                        <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding TopShapes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding TopShape}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="{Binding TopAngleText}"
                                                   ToolTip="Angle du dessus par rapport à l'horizontale. 0° = plat. Au-delà de 14° (frottement plastique sur plastique), un produit posé dessus glisse." />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Width="54" Margin="8,0,0,0" Text="{Binding TopAngle, TargetNullValue=''}" />
                                            <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    Value="{Binding TopAngleValue}" AutomationProperties.Name="Angle du dessus" />
                                        </DockPanel>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding ClearTopShapeCommand}" Padding="6,2" Margin="8,0,0,4"
                                            VerticalAlignment="Bottom" ToolTip="Ne plus décrire le dessus">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>

                                <!-- Poignée -->
                                <DockPanel Margin="0,10,0,0" Visibility="{Binding HasHandle, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding AddHandleCommand}" Margin="8,0,0,0"
                                            ToolTip="Ajouter une poignée ou une anse : type, forme et dimensions">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,2,6,0" />
                                            <TextBlock Text="Ajouter une poignée" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding NoHandleText}" />
                                </DockPanel>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasHandle, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Poignée / anse"
                                                       ToolTip="Encastrée : ne dépasse pas le plan du dessus. Saillante : dépasse (rien ne repose dessus sans intercalaire rigide). Rabattable : anse couchée à plat." />
                                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Handles}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Handle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="Forme de la poignée"
                                                       ToolTip="Arrondie : section ronde, un intercalaire ne la touche que sur une ligne. Droite : dessus plat." />
                                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding HandleShapes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding HandleRoundedChoice}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding RemoveHandleCommand}" Padding="6,2" Margin="8,0,0,4"
                                                VerticalAlignment="Bottom" ToolTip="Retirer la poignée (produit sans poignée)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="11" Margin="0,2,5,0" />
                                                <TextBlock Text="Retirer" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HandleLengthLabel}" ToolTip="Longueur de la poignée en mm, au plus la longueur du produit (le diamètre pour un fût, un seau, une bouteille). Vide : proportion usuelle." />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding HandleLength, TargetNullValue=''}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HandleWidthLabel}" ToolTip="Largeur de la poignée en mm, au plus la largeur du produit. Vide : proportion usuelle." />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding HandleWidth, TargetNullValue=''}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HandleHeightLabel}" ToolTip="Hauteur de la poignée en mm, au plus la hauteur du produit : saillie au-dessus du corps, ou profondeur du puits si elle est encastrée." />
                                            <TextBox Style="{StaticResource NumBox}" Text="{Binding HandleHeight, TargetNullValue=''}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0" Visibility="{Binding HandleRoundedChoice, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HandleAngleLeftText}"
                                                       ToolTip="Inclinaison du côté gauche de la poignée par rapport à la verticale : 0° = côté vertical, jusqu'à 80°." />
                                            <DockPanel>
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Width="54" Margin="8,0,0,0" Text="{Binding HandleAngleLeft, TargetNullValue=''}" />
                                                <Slider Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                        Value="{Binding HandleAngleLeftValue}" AutomationProperties.Name="Angle du côté gauche de la poignée" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="{Binding HandleAngleRightText}"
                                                       ToolTip="Inclinaison du côté droit de la poignée par rapport à la verticale : 0° = côté vertical, jusqu'à 80°." />
                                            <DockPanel>
                                                <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Width="54" Margin="8,0,0,0" Text="{Binding HandleAngleRight, TargetNullValue=''}" />
                                                <Slider Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                        Value="{Binding HandleAngleRightValue}" AutomationProperties.Name="Angle du côté droit de la poignée" />
                                            </DockPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Angle de chaque côté par rapport à la verticale (0° = côté vertical) : plus les côtés sont inclinés, plus le dessus de la poignée raccourcit (appui sur intercalaire réduit)." />
                                    </Grid>
                                    <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding HandleSolid}" Margin="0,8,0,0"
                                              Content="Poignée pleine (moulée d'un seul tenant avec le corps)"
                                              ToolTip="Poignée sans ouverture, liée au corps : dessinée pleine dans l'aperçu et les vues 3D. Décochée : poignée ouverte." />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Dimensions en mm, jamais plus grandes que celles du produit. Vide : proportions usuelles, calcul comme avant." />
                                </StackPanel>

                                <!-- Verdict -->
                                <Border CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Background="{StaticResource SoftPanelBrush}" BorderThickness="3,0,0,0"
                                        BorderBrush="{Binding TopVerdictColor, Converter={StaticResource HexToBrush}}"
                                        Visibility="{Binding TopRule, Converter={StaticResource NotNullToVisibility}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearAllTopCommand}" Padding="4,1"
                                                    ToolTip="Tout effacer (dessus et poignée) : retour au calcul par défaut">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                                            </Button>
                                            <TextBlock Text="{Binding TopVerdict}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding TopVerdictColor, Converter={StaticResource HexToBrush}}" />
                                        </DockPanel>
                                        <Expander Header="Pourquoi ? (raisonnement pas à pas)" Margin="0,4,0,0" FontSize="12">
                                            <ItemsControl ItemsSource="{Binding TopSteps}" Margin="4,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Sac : tassement à la mise en caisse -->
                            <StackPanel Visibility="{Binding ShowCompression, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="TASSEMENT À LA MISE EN CAISSE" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Style="{StaticResource FormCheck}" IsChecked="{Binding Compressible}" VerticalAlignment="Center"
                                              Content="Tassable en caisse"
                                              ToolTip="On peut appuyer pour en mettre plus en caisse : l'air est chassé, l'épaisseur diminue, l'empreinte ne change pas. Décoché : épaisseur saisie conservée." />
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" IsEnabled="{Binding Compressible}">
                                        <TextBox Style="{StaticResource NumBox}" Width="64" Text="{Binding CompressionPercent, TargetNullValue=''}"
                                                 ToolTip="Tassement maxi de l'épaisseur (%). Vide : 10 %. Au plus 25 % ; pour des sacs pleins, rester sous 15 %." />
                                        <TextBlock Text="% de l'épaisseur" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CompressionText}" />
                            </StackPanel>

                            <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                                    ToolTip="Déduit automatiquement (aucune donnée supplémentaire à saisir) ; renseignez « Charge maxi sur le dessus » ou « Fragile » pour l'affiner.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Margin="0,2,8,0" Foreground="{StaticResource PrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="Profil de gerbage (palettes hétérogènes)" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding ProfileText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="CLASSEMENT ET INFORMATIONS (facultatifs)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Client" />
                                    <ComboBox Style="{StaticResource FormCombo}" SelectedValue="{Binding Client}" SelectedValuePath="Code"
                                              ItemsSource="{Binding DataContext.Clients, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource OwnView}}"
                                              b:ComboFilter.MinItems="0" ToolTip="Client de l'article (le code est enregistré)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Famille" />
                                    <ComboBox Style="{StaticResource FormCombo}" IsEditable="True" Text="{Binding Family}"
                                              ItemsSource="{Binding DataContext.Families, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Sous-famille" />
                                    <ComboBox Style="{StaticResource FormCombo}" IsEditable="True" Text="{Binding SubFamily}"
                                              ItemsSource="{Binding DataContext.SubFamilies, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Référence client" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding CustomerRef}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="EAN / GTIN" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Ean}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Couleur d'affichage" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Margin="0,0,6,0"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding Color}" ToolTip="#RRGGBB ; vide = couleur automatique" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Right" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="20" Height="20" Margin="2" Cursor="Hand" ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="5" Background="{Binding Converter={StaticResource HexToBrush}}" BorderBrush="White" BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Notes" />
                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Aperçu 3D -->
                <Border Grid.Column="1" Background="{StaticResource SoftPanelBrush}" CornerRadius="0,10,10,0">
                    <DockPanel Margin="14">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="APERÇU" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" DataContext="{Binding SelectedArticle}" Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                <Run Text="Créé le " /><Run Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                                <Run Text=" · modifié le " /><Run Text="{Binding ModifiedAt, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Border CornerRadius="10" Background="{StaticResource CardBrush}" ClipToBounds="True">
                            <h:HelixViewport3D x:Name="Preview" Background="{StaticResource Viewport3DBrush}" ZoomAroundMouseDownPoint="True" ShowViewCube="False"
                                               IsHeadLightEnabled="True" ModelUpDirection="0,0,1" ShowCoordinateSystem="True" CoordinateSystemLabelForeground="{StaticResource MutedBrush}">
                                <h:DefaultLights />
                                <ModelVisual3D Content="{Binding Preview}" />
                            </h:HelixViewport3D>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
